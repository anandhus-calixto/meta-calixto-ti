create_am335x_versa_image () {

CALIXTO_IMAGE_PATH_SDCARD="${DEPLOY_DIR_IMAGE}/calixto-images/${MACHINE}/sdcard"

rm -rf ${CALIXTO_IMAGE_PATH_SDCARD}
mkdir -p ${CALIXTO_IMAGE_PATH_SDCARD}

echo "DEPLOY_DIR_IMAGE = ${DEPLOY_DIR_IMAGE}"
echo "MACHINE = ${MACHINE}"

cp ${DEPLOY_DIR_IMAGE}/MLO ${CALIXTO_IMAGE_PATH_SDCARD}/MLO
#cp ${B}/MLO.byteswap ${CALIXTO_IMAGE_PATH_SDCARD}/MLO.byteswap
cp ${DEPLOY_DIR_IMAGE}/u-boot.img ${CALIXTO_IMAGE_PATH_SDCARD}/u-boot.img
cp ${DEPLOY_DIR_IMAGE}/${KERNEL_DEVICETREE} ${CALIXTO_IMAGE_PATH_SDCARD}/
cp ${DEPLOY_DIR_IMAGE}/${IMAGE_LINK_NAME}.rootfs.tar.xz  ${CALIXTO_IMAGE_PATH_SDCARD}/

}
